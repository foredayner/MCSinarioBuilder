// ---------- 3. Stone footing (dry-stacked, mixed cobble / mossy) ----------
for (int x = 2; x <= 12; x++) {
    for (int z = -12; z <= -5; z++) {
        int h = (x * 73856093) ^ (0 * 19349663) ^ (z * 83492791);
        h = (h ^ (h >>> 13)) * 1274126177;
        int hv = (h ^ (h >>> 16)) & 0x7fffffff;
        String b = (hv % 3 == 0) ? 'mossy_cobblestone' : 'cobblestone';
        ai.placeBlock(x, 0, z, b);
    }
}
// veranda footing
